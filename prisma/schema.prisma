// Gunderhouse — household / property management
//
// Design notes:
// - Everything of substance (appliances, maintenance, documents) hangs off a Home.
//   Homes are open-ended; nothing assumes a fixed number of them.
// - Access is granted per home via HomeMembership. A user with systemRole OWNER is a
//   household admin: they implicitly have ADMIN on every home and can invite people.
//   Everyone else sees only the homes they hold a membership for.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// People & access
// ---------------------------------------------------------------------------

/// Household-wide standing. OWNER is a peer admin of the whole household.
enum SystemRole {
  OWNER
  MEMBER
}

/// What someone may do with the household budget. Household admins (systemRole
/// OWNER) always have full access and ignore this; it governs everyone else.
///
/// Deliberately separate from HomeRole: access to a house says nothing about
/// whether you should see the family's income. A teenager can log maintenance
/// on the house they live in without seeing what their parents earn.
enum BudgetRole {
  /// No budget at all — the tab doesn't appear.
  NONE
  /// Read what they're allowed to see; change nothing.
  VIEWER
  /// The above, plus logging and editing spending.
  EDITOR
}

/// Per-home access level.
enum HomeRole {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String
  passwordHash      String
  systemRole        SystemRole @default(MEMBER)
  /// Budget access for non-admins. Defaults to NONE so a new person sees
  /// nothing financial until someone deliberately grants it.
  budgetRole        BudgetRole @default(NONE)
  /// Bumped whenever the password changes. Sessions issued before this moment
  /// are rejected, so a reset ends any session the old password had opened.
  passwordChangedAt DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  memberships          HomeMembership[]
  invitationsSent      Invitation[]       @relation("InvitationInvitedBy")
  maintenanceLogged    MaintenanceEntry[] @relation("MaintenanceCreatedBy")
  documentsUploaded    Document[]         @relation("DocumentUploadedBy")
  passwordResets       PasswordReset[]    @relation("PasswordResetUser")
  passwordResetsIssued PasswordReset[]    @relation("PasswordResetIssuedBy")
  projectsCreated      Project[]          @relation("ProjectCreatedBy")
  budgetEntries        BudgetEntry[]      @relation("BudgetEntryCreatedBy")
}

/// A single-use link letting someone set a new password. Issued by a household
/// admin and handed over directly — same approach as invitations, so the app
/// needs no email provider.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  issuedById String?
  createdAt  DateTime @default(now())

  user     User  @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy User? @relation("PasswordResetIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([userId])
}

model HomeMembership {
  id     String   @id @default(cuid())
  userId String
  homeId String
  role   HomeRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@unique([userId, homeId])
  @@index([homeId])
}

/// A pending invitation to join the household. Accepting it creates the User
/// (and the initial home membership, if one was specified).
model Invitation {
  id         String     @id @default(cuid())
  email      String
  name       String
  token      String     @unique
  systemRole SystemRole @default(MEMBER)

  /// Optional initial home grant, applied when the invitation is accepted.
  homeId   String?
  homeRole HomeRole?

  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  invitedBy User  @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  home      Home? @relation(fields: [homeId], references: [id], onDelete: SetNull)

  @@index([email])
}

// ---------------------------------------------------------------------------
// Homes
// ---------------------------------------------------------------------------

enum HomeType {
  PRIMARY_RESIDENCE
  RENTAL
}

model Home {
  id   String   @id @default(cuid())
  name String
  type HomeType @default(PRIMARY_RESIDENCE)

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?

  yearBuilt   Int?
  squareFeet  Int?
  purchasedOn DateTime?
  notes       String?

  /// What you plan to spend on this house per month — upkeep and improvements.
  /// Optional; without it the budget reports what the house costs without
  /// judging it against a target.
  monthlyBudgetCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships HomeMembership[]
  appliances  Appliance[]
  maintenance MaintenanceEntry[]
  tasks       MaintenanceTask[]
  projects    Project[]
  documents   Document[]
  invitations Invitation[]
  budgetCategories BudgetCategory[]
}

// ---------------------------------------------------------------------------
// Appliances & home systems
// ---------------------------------------------------------------------------

/// Categories double as the key into the expected-lifespan table used by the
/// forecast (see lib/lifespans.ts). Includes whole-home systems (roof, HVAC)
/// alongside conventional appliances.
enum ApplianceCategory {
  WATER_HEATER
  FURNACE
  AIR_CONDITIONER
  HEAT_PUMP
  BOILER
  ROOF
  DISHWASHER
  REFRIGERATOR
  FREEZER
  RANGE_OVEN
  MICROWAVE
  WASHER
  DRYER
  GARBAGE_DISPOSAL
  WATER_SOFTENER
  SUMP_PUMP
  WELL_PUMP
  SEPTIC_SYSTEM
  GARAGE_DOOR_OPENER
  GENERATOR
  WATER_HEATER_TANKLESS
  OTHER
}

model Appliance {
  id     String @id @default(cuid())
  homeId String

  name         String
  category     ApplianceCategory @default(OTHER)
  brand        String?
  modelNumber  String?
  serialNumber String?
  location     String?

  /// Date the unit went into service *here*. For something bought new this is
  /// also its age; for something bought used it isn't, which is what modelYear
  /// is for.
  installedOn       DateTime?
  /// The unit's actual vintage, when it differs from installedOn — a used
  /// appliance is as old as it is, not as old as your ownership of it. The
  /// forecast ages from this whenever it's set.
  modelYear         Int?
  warrantyExpiresOn DateTime?

  /// Per-unit override of the category's expected service life. Commercial-grade
  /// machines outlast their category and would otherwise be flagged years early;
  /// a known-tired unit can be pulled the other way. Either end may be set alone.
  expectedLifeLowYears  Int?
  expectedLifeHighYears Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  home        Home               @relation(fields: [homeId], references: [id], onDelete: Cascade)
  maintenance MaintenanceEntry[]
  tasks       MaintenanceTask[]

  @@index([homeId])
}

// ---------------------------------------------------------------------------
// Maintenance & repair log
// ---------------------------------------------------------------------------

/// Where an entry came from. Completing a routine task through Alfred or Lucy
/// records ALFRED, so the log distinguishes assistant-driven writes.
enum LogSource {
  APP
  ALFRED
}

model MaintenanceEntry {
  id          String  @id @default(cuid())
  homeId      String
  /// Null for home-level work that isn't tied to a specific appliance.
  applianceId String?
  /// Set when this entry was the completion of a routine task.
  taskId      String?

  performedOn DateTime
  description String
  /// Stored in cents to keep money out of floating point.
  costCents   Int?
  vendor      String?
  notes       String?
  loggedVia   LogSource @default(APP)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  home      Home             @relation(fields: [homeId], references: [id], onDelete: Cascade)
  appliance Appliance?       @relation(fields: [applianceId], references: [id], onDelete: SetNull)
  task      MaintenanceTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("MaintenanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([homeId, performedOn])
  @@index([applianceId])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Routine (recurring) maintenance
// ---------------------------------------------------------------------------

enum RecurrenceUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

/// A job that comes back on a schedule — furnace filter every 3 months, gutters
/// every autumn. Optionally tied to an appliance; left loose when there's
/// nothing to tie it to.
///
/// Completing one advances `nextDueOn` and writes a MaintenanceEntry, so the
/// home keeps a single maintenance history rather than two parallel ones.
model MaintenanceTask {
  id          String  @id @default(cuid())
  homeId      String
  /// Null when the job isn't about one specific unit.
  applianceId String?

  title String
  notes String?

  intervalValue Int
  intervalUnit  RecurrenceUnit

  nextDueOn       DateTime
  lastCompletedOn DateTime?
  /// Paused tasks keep their history but stop showing up as due.
  active          Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  home        Home               @relation(fields: [homeId], references: [id], onDelete: Cascade)
  appliance   Appliance?         @relation(fields: [applianceId], references: [id], onDelete: SetNull)
  completions MaintenanceEntry[]

  @@index([homeId, nextDueOn])
  @@index([applianceId])
}

// ---------------------------------------------------------------------------
// Planned projects
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNED
  DONE
}

/// Work you intend to do and what you expect it to cost — a new kitchen floor,
/// a driveway, a bathroom. Deliberately separate from MaintenanceTask: a task
/// recurs on a schedule, a project happens once. Kept out of the maintenance
/// log too, since an improvement isn't upkeep; the forecast is where planned
/// spend belongs.
model Project {
  id     String @id @default(cuid())
  homeId String

  title String
  notes String?

  /// What you expect it to cost, in cents like every other amount. Optional:
  /// this doubles as the house to-do list, and plenty gets written down before
  /// it gets priced. Unpriced projects are listed but left out of the totals.
  estimatedCostCents Int?
  /// Roughly when — optional, since plenty of projects are "eventually".
  targetOn           DateTime?

  status          ProjectStatus @default(PLANNED)
  completedOn     DateTime?
  /// What it actually came to, recorded on completion.
  actualCostCents Int?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  home      Home  @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([homeId, status, targetOn])
}

/// A pending write proposed by Alfred or Lucy, waiting on a human "yes".
///
/// The assistant asks first and gets back a summary plus this token; nothing
/// changes until it sends the token back. Tokens are single-use and short-lived,
/// so a stale or replayed confirmation can't write anything.
model AlfredConfirmation {
  id      String @id @default(cuid())
  token   String @unique
  action  String
  /// Human-readable description of exactly what will happen, for the assistant
  /// to read back before asking for confirmation.
  summary String
  /// The proposed write, applied verbatim on confirmation.
  payload Json

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Document repository
// ---------------------------------------------------------------------------

enum DocumentCategory {
  INSURANCE
  WARRANTY
  MANUAL
  RECEIPT
  LEASE
  TAX
  INSPECTION
  OTHER
}

model Document {
  id     String @id @default(cuid())
  homeId String

  title       String
  category    DocumentCategory @default(OTHER)
  description String?

  fileName    String
  contentType String
  sizeBytes   Int
  /// Opaque key in whichever storage driver is configured (S3/R2 or local disk).
  storageKey  String

  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  home       Home  @relation(fields: [homeId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([homeId, category])
}

// ---------------------------------------------------------------------------
// Household budget
//
// Deliberately not a general-ledger accounting system. Two kinds of money are
// tracked differently, because they behave differently:
//
//   - Recurring, known amounts (Disney+, insurance, the mortgage) are entered
//     once as a RecurringItem and counted every month from then on. There is
//     nothing to confirm each month; the charge happens whether or not anyone
//     opens the app.
//   - Variable amounts (groceries, a one-off repair, income received) are
//     BudgetEntry rows. One row a month per category is enough — "groceries,
//     $1,240, March" — and finer entry is allowed but never required. Budget
//     tools die when they demand per-receipt bookkeeping.
//
// House upkeep is not re-entered here at all. Maintenance entries and finished
// projects already carry costs, so the budget reads them where they are.
// ---------------------------------------------------------------------------

enum BudgetKind {
  INCOME
  EXPENSE
}

/// Who in the household may see a category — and everything inside it.
enum BudgetVisibility {
  /// Anyone with budget access.
  EVERYONE
  /// Household admins only. Income and the bills usually belong here.
  ADMINS
}

enum Cadence {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

/// A line in the budget: "Groceries", "Subscriptions", "Angela's salary".
model BudgetCategory {
  id   String     @id @default(cuid())
  name String
  kind BudgetKind @default(EXPENSE)

  /// What you plan for this category each month. Null means "track it, don't
  /// judge it" — useful for categories that are purely their recurring items.
  monthlyTargetCents Int?

  /// Set when the category belongs to one house — its mortgage, its insurance.
  /// Null for anything household-wide: groceries, streaming, income.
  homeId String?

  /// Who may see this line, its recurring charges, and everything logged
  /// against it. Defaults to admins only: money is private until it is
  /// deliberately shared, not the other way round.
  visibility BudgetVisibility @default(ADMINS)

  /// Whether Alfred and Lucy may read this category. Separate from visibility
  /// because the assistant is not a household member — it holds a shared token
  /// and has no identity behind it. Leaving the mortgage readable so Alfred can
  /// answer "when is it due" is a different decision from letting the kids see
  /// it, and the two shouldn't be forced together.
  assistantAccess Boolean @default(true)

  sortOrder Int     @default(0)
  /// Archived categories keep their history but stop appearing in new months.
  archived  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  home      Home?           @relation(fields: [homeId], references: [id], onDelete: Cascade)
  recurring RecurringItem[]
  entries   BudgetEntry[]

  @@index([archived, sortOrder])
  @@index([homeId])
}

/// A charge that repeats on its own: a subscription, a premium, a payment.
model RecurringItem {
  id         String @id @default(cuid())
  categoryId String

  label       String
  amountCents Int
  cadence     Cadence @default(MONTHLY)

  /// Bounds, for things that haven't started yet or have ended. A month outside
  /// this window doesn't count the item.
  startsOn DateTime?
  endsOn   DateTime?
  active   Boolean   @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, active])
}

/// Money that actually moved: groceries bought, a paycheque received.
model BudgetEntry {
  id         String @id @default(cuid())
  categoryId String

  occurredOn  DateTime
  amountCents Int
  description String?

  createdById String?
  source      LogSource @default(APP)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("BudgetEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([categoryId, occurredOn])
  @@index([occurredOn])
}
