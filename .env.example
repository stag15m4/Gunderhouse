# ---------------------------------------------------------------------------
# Database (Railway Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/gunderhouse"

# ---------------------------------------------------------------------------
# Auth (Auth.js / next-auth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the deployment. This must be the domain people actually visit,
# not the railway.app one — Auth.js builds its sign-in callbacks from it, and a
# mismatch fails at login rather than at boot.
# Production: https://gunderhouse.sethgundersen.com
AUTH_URL="http://localhost:3000"
# Set to 1 behind Railway's proxy so Auth.js trusts the forwarded host.
AUTH_TRUST_HOST="1"

# ---------------------------------------------------------------------------
# Document storage
# ---------------------------------------------------------------------------
# "s3" (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2) or "local" (dev only).
STORAGE_DRIVER="s3"

# --- s3 driver ---
S3_BUCKET="gunderhouse-documents"
S3_REGION="auto"
# R2: https://<account-id>.r2.cloudflarestorage.com
# AWS: leave blank to use the default regional endpoint.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# R2 and most S3-compatible providers need path-style addressing.
S3_FORCE_PATH_STYLE="1"

# --- local driver ---
# Directory for uploaded files. On Railway this must be a mounted volume.
LOCAL_STORAGE_DIR="./storage"

# ---------------------------------------------------------------------------
# Alfred / Lucy read-only integration
# ---------------------------------------------------------------------------
# Shared secret checked against the X-Alfred-Token request header.
# Generate with: openssl rand -hex 32
ALFRED_TOKEN=""

# ---------------------------------------------------------------------------
# Legal app integration
# ---------------------------------------------------------------------------
# Shared secret checked against the X-Legal-Token request header. A different
# secret from ALFRED_TOKEN on purpose — different caller, different reach.
# Generate with: openssl rand -hex 32
LEGAL_TOKEN=""

# ---------------------------------------------------------------------------
# Seeding (npm run db:seed) — creates the first OWNER account.
# ---------------------------------------------------------------------------
SEED_OWNER_EMAIL="you@example.com"
SEED_OWNER_NAME="Your Name"
SEED_OWNER_PASSWORD="change-me-after-first-login"
